        {"user": "আমার শহরের আবহাওয়া সাধারণত কেমন?", "memory": true, "refers_to": "চট্টগ্রাম",
         "expect": {"any": ["চট্টগ্রাম", "সমুদ্র", "আর্দ্র", "গরম", "বৃষ্টি", "উপকূল"]}},
        {"user": "আমার নাম কী বলেছিলাম?", "memory": true, "refers_to": "রফিক",
         "expect": {"any": ["রফিক"]}}
      ]
    },
    {
      "id": "topic_switch_then_return",
      "domain": "memory_probe",
      "turns": [
        {"user": "বাংলাদেশের জাতীয় ফুল কোনটি?", "memory": false,
         "expect": {"any": ["শাপলা"]}},
        {"user": "আজ কি বৃষ্টি হবে?", "memory": false,
         "expect": {"any": ["আবহাওয়া", "জানি না", "বলতে পারছি না", "তথ্য", "পূর্বাভাস", "বৃষ্টি"]}},
        {"user": "আগে যে ফুলটার কথা বললে, সেটা কোথায় ফোটে?", "memory": true, "refers_to": "শাপলা",
         "expect": {"any": ["শাপলা", "পুকুর", "জল", "বিল", "হাওর", "পানি"]}}
      ]
