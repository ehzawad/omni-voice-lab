# Copy to deploy/.env and fill in. Nothing else needs editing to bring the stack up.

# A DNS A record for this must point at the VM's public IP BEFORE first start; Caddy uses it
# to obtain the TLS certificate. Without TLS the browser will not expose the microphone.
HV_DOMAIN=voice.example.com

# Bearer token the browser must present. Generate: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
HV_GW_TOKEN=

# Hugging Face token: needed once to pull the gated Gemma weights into the hf-cache volume.
HF_TOKEN=

# --- tuning, all optional ---------------------------------------------------------------
# vLLM KV cache, absolute bytes. 3103113871 (2.89 GiB) is what the measured run actually used and
# serves ~26 concurrent 2048-token conversations; raise toward 11253448704 (10.48 GiB) on a
# 24 GB card that runs ONLY vLLM. Set 0 to fall back to --gpu-memory-utilization.
HV_LLM_KV_CACHE_BYTES=3103113871
HV_LLM_MAX_MODEL_LEN=2048

# IndicF5 solver steps. 16 measured ~1.6 s per sentence, 32 ~3.1 s. Quality cost of 16 not yet measured.
HV_TTS_NFE=16

# End-of-turn silence, ms. Measured knee on real spontaneous Bengali is 700 (see hervoice/svc/config.py).
HV_MIN_SILENCE_MS=700

# Concurrent conversations. TTS is single-flight and non-interruptible; one 24 GB card supports 3-4.
HV_MAX_SESSIONS=1
